{
  "name": "Hitbullseye Automate Tool",
  "version": "4.0.0",
  "description": "AI-powered auto-solver for hitbullseye.com tests: answers multiple-choice and numerical questions with Gemini.",
  "author": "ethical hacker",
  "default_locale": "en",
  "manifest_version": 3,
  "icons": {
    "16": "./images/icon.svg",
    "32": "./images/icon.svg",
    "48": "./images/icon.svg",
    "128": "./images/icon.svg"
  },
  "background": {
    "service_worker": "background.js",
    "scripts": ["solver.js", "background.js"]
  },
  "permissions": ["scripting", "activeTab", "storage", "clipboardWrite"],
  "host_permissions": ["https://generativelanguage.googleapis.com/*", "<all_urls>"],
  "action": {
    "default_popup": "./popup/popup.html",
    "default_icon": "./images/icon.svg"
  },
  "content_scripts": [
    {
      "matches": ["https://*.hitbullseye.com/*"],
      "js": ["solver.js", "toast.js", "content.js"]
    }
  ]
}
